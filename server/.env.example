# Скопируйте в .env и заполните. .env не коммитить.

# Токен устройства: тот же, что API_TOKEN в firmware/autopoliv_ui/secrets.h.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
PLANT_TOKEN=

# Вход в веб-интерфейс (HTTP Basic)
PLANT_WEB_USER=admin
PLANT_WEB_PASSWORD=

# Порт на сервере
PLANT_PORT=8000

# ИИ (чат, «Почему полили?»): gigachat | openai | none. Без ключа ИИ выключен, остальное работает.
LLM_PROVIDER=gigachat
# GigaChat: «Ключ авторизации» из личного кабинета developers.sber.ru (уже в base64, как есть)
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# OpenAI-совместимый провайдер (DeepSeek, YandexGPT и др.) — при LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-chat

# Голос «Джарвис» (распознавание и синтез на сервере, CPU, ≥ 4 ГБ RAM)
VOICE_ENABLED=1
# Загрузить модели при старте (первый запуск скачивает ~0.5 ГБ в /data/models/voice)
VOICE_PRELOAD=1
# WHISPER_MODEL=small        # base — быстрее, small — точнее
# TTS_SPEAKER=aidar          # мужской голос Silero; женские: baya, kseniya, xenia

# Демо-режим для записи видео (D1): интервал между поливами сервера 2 мин, метка DEMO
# DEMO_MODE=1
# Переобучение прогноза раз в N часов (0 — выключить)
# ML_RETRAIN_HOURS=24

# Только для локального запуска: разрешить работу без токена и пароля
# PLANT_INSECURE=1
