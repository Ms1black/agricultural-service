# Скопируйте в .env и заполните. .env не коммитить.

# Токен устройства: тот же, что API_TOKEN в firmware/autopoliv_ui/secrets.h.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
PLANT_TOKEN=

# Вход в веб-интерфейс (HTTP Basic)
PLANT_WEB_USER=admin
PLANT_WEB_PASSWORD=

# Порт на сервере
PLANT_PORT=8000

# Только для локального запуска: разрешить работу без токена и пароля
# PLANT_INSECURE=1
